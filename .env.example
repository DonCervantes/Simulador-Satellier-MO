# CesiumJS Ion token (free at https://cesium.com/ion/tokens)
CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Backend
DATABASE_URL=postgresql+asyncpg://satellier:satellier@localhost:5432/satellier
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# Frontend (Vite env vars — must start with VITE_)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_CESIUM_TOKEN=${CESIUM_ION_TOKEN}
